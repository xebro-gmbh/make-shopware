# Route snippet of the shopware bundle: shop under ${XO_SHOP_PATH_PREFIX}/.
# Publicly the prefix is preserved; internally it is stripped and replaced by
# X-Forwarded-Prefix (Symfony convention — without stripping, /admin, /api
# and /store-api would be 404 under the prefix). Same contract as in
# production (where a CloudFront function does the stripping).

location = ${XO_SHOP_PATH_PREFIX} {
    return 301 ${XO_SHOP_PATH_PREFIX}/;
}

location ^~ ${XO_SHOP_PATH_PREFIX}/ {
    rewrite ^${XO_SHOP_PATH_PREFIX}(/.*)$ $1 break;
    proxy_pass http://shopware:80;
    proxy_set_header Host                $host;
    proxy_set_header X-Forwarded-Proto   https;
    proxy_set_header X-Forwarded-Port    ${XO_PROXY_HTTPS_PORT};
    proxy_set_header X-Forwarded-For     $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Prefix  ${XO_SHOP_PATH_PREFIX};
}
