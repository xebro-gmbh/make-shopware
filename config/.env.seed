# Seeded once by `make shopware.install` — an existing value in .env is never
# overwritten. Shopware version = shopware/production release on Packagist.
XO_SHOPWARE_VERSION=6.7.13.0
BASE_ECR_REGISTRY=641495738494.dkr.ecr.eu-central-1.amazonaws.com
# Tag of the dev image. base-dev is the rolling tag; projects pin the
# immutable dev-<build> in their committed .env and let Renovate bump it.
XO_SHOPWARE_BASE_DEV_TAG=base-dev
XO_SHOPWARE_HTTP_PORT=8080
XO_SHOPWARE_XDEBUG_MODE=off
XO_SHOPWARE_APP_URL=http://localhost:8080
XO_SHOPWARE_TRUSTED_PROXIES=
XO_SHOPWARE_HEALTHCHECK_PATH=/
XO_SHOP_PATH_PREFIX=/shop
XO_SHOPWARE_THEME=
XO_SHOPWARE_FIXTURES_CMD=
XO_SHOPWARE_PROJECT_DIR=.
# Application settings that projects may override after the initial seed.
XO_SHOPWARE_APP_ENV=dev
XO_SHOPWARE_APP_SECRET=dev-secret-not-for-production-0123456789abcdef0123456789abcdef
XO_SHOPWARE_SKIP_WEBINSTALLER=1
XO_SHOPWARE_COMPOSER_HOME=/tmp/composer
